generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model VideoPost {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  videoUrl        String
  durationSeconds Int
  width           Int
  height          Int
  mimeType        String
  reportedCount   Int      @default(0)
  reports         Report[]

  @@index([createdAt, id])
}

model Report {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  videoPostId String
  ipHash      String
  videoPost   VideoPost @relation(fields: [videoPostId], references: [id])

  @@index([videoPostId])
  @@index([ipHash])
}
