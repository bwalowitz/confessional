# Database
DATABASE_URL=postgresql://user:password@localhost:5432/confessional
DIRECT_URL=postgresql://user:password@localhost:5432/confessional

# S3-compatible storage
S3_REGION=us-east-1
S3_BUCKET=confessional-uploads
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://confessional-uploads.s3.amazonaws.com
S3_FORCE_PATH_STYLE=false

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
IP_HASH_SALT=change-me
ADMIN_PASSWORD=change-me-admin
ADMIN_SESSION_SECRET=change-me-admin-session-secret

# Limits
MAX_UPLOAD_BYTES=15000000
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_SECONDS=300

# Optional durable rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
